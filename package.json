{
  "description": "A note document related to web3d.",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Norush",
    "url": "https://github.com/Alicehhhmm"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Alicehhhmm/nnd-threejs.git"
  },
  "keywords": [
    "webgl",
    "webgpu",
    "canvas",
    "threejs",
    "web3d",
    "web2d",
    "graphics"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "pnpm --filter website dev",
    "-----c------": "---------------codeing--------------------",
    "prepare": "husky install",
    "clean:dist": "rimraf dist",
    "clean:install": "rimraf node_modules && rimraf pnpm-lock.yaml",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint-staged": "lint-staged",
    "------m-----": "---------------release--------------------",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "dependencies": {
    "dat.gui": "^0.7.9",
    "gsap": "^3.12.2",
    "three": "^0.152.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.11.16",
    "@types/three": "^0.161.2",
    "@vitest/coverage-v8": "^1.2.2",
    "@vitest/ui": "^1.2.2",
    "eslint": "^9.37.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "husky": "^9.0.10",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.2.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "rimraf": "^5.0.0",
    "vite": "^7.1.0",
    "vitest": "^1.2.2"
  },
  "lint-staged": {
    "*.{json,css,md}": [
      "prettier --write"
    ],
    "*.{js,jsx,tsx,ts,vue}": [
      "eslint --fix"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
